[codespell]
skip = ./.git,./.vscode/*,./composer.lock,./runtime/*,./vendor/*,./internal/*,./node_modules/*,./foxy.lock,./.phpunit.cache/*,./code_coverage/*,./.claude/*,./.codex/*,./.config/gh/*,./.github/agents/*,./.github/copilot-instructions.md,./.github/copilot/*,./.github/instructions/*,./.github/prompts/*,./.github/skills/*,./composer.json,./package-lock.json,./CHANGELOG.md,./UPGRADE.md,*/tests/*
